# Copy to .env.local for local dev. See docs/SECURITY_SETUP.md.

# Supabase service-role secret (Project Settings -> API keys -> service_role).
# Server-only — bypasses RLS. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Secret slug for the admin dashboard URL: /admin/<ADMIN_KEY>
ADMIN_KEY=

# ntfy.sh topic for feedback push notifications (optional locally)
NTFY_TOPIC=
